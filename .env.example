# Telegram bot token from BotFather. Keep server-side only.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID allowed to execute bot admin actions.
TELEGRAM_OWNER_ID=
# Random secret passed when registering the Telegram webhook.
TELEGRAM_WEBHOOK_SECRET=
# Deployed Mini App origin, e.g. https://quickdraft.vercel.app
APP_URL=
# Bot username without @, used for shortcut/deep-link examples.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
